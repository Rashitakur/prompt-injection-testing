#!/bin/bash
#SBATCH --job-name=pi-00-download
#SBATCH --partition=cpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
# NOTE: needs internet. If compute nodes are offline, run on the LOGIN node instead:
#       ALLOW_DOWNLOAD=1 bash slurm/00_download.job
export ALLOW_DOWNLOAD=1
source slurm/common.sh
# For gated models (Llama) first run: huggingface-cli login
python scripts/download_assets.py --config "${CONFIG}"
