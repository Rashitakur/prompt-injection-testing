#!/bin/bash
#SBATCH --job-name=pi-smoke
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
# End-to-end check with tiny random models + synthetic data (no downloads needed).
# Run this FIRST to validate the environment, modules and GPU before the real pipeline.
source slurm/common.sh
bash scripts/run_smoke.sh
