#!/bin/bash
#SBATCH --job-name=pi-05-ppl
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
source slurm/common.sh
python scripts/run_detector.py --config "${CONFIG}" --detector ppl_gpt2
